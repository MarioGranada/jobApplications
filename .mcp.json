{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless",
        "--storage-state=${HOME}/.playwright-auth/linkedin.json"
      ],
      "env": {}
    },
    "playwright-sheet": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--storage-state=${HOME}/.playwright-auth/linkedin.json"
      ],
      "env": {}
    }
  }
}
